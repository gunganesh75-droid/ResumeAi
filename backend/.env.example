# Server Configuration
PORT=5000

# JSON Web Token Secret key
JWT_SECRET=your_jwt_secret_key_here

# Legacy Database Configuration (MySQL)
# DB_HOST=localhost
# DB_USER=root
# DB_PASSWORD=your_mysql_password_here
# DB_NAME=resume_ai

# MongoDB Database Configuration
MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.mongodb.net/resume_ai?retryWrites=true&w=majority

# SMTP Email Configuration (Resend SMTP)
SMTP_HOST=smtp.resend.com
SMTP_PORT=465
SMTP_USER=resend
SMTP_PASS=your-resend-api-key-here
SMTP_FROM="ResumeAI Verification" <onboarding@resend.dev>

# ── Gemini API ──────────────────────────────────
GEMINI_API_KEY=your_gemini_api_key_here
